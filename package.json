    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "vite": "^6.4.1"
  }
}
